model Enrollment {
  id                   String           @id @default(cuid())
  reference            String           @unique
  studentId            String
  courseId             String
  priceAtEnrollment    Decimal          @db.Decimal(12, 2)
  currencyAtEnrollment String           @default("BDT")
  status               EnrollmentStatus @default(PENDING_PAYMENT)
  assignedTeacherId    String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  student         Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course          Course                     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignedTeacher User?                      @relation("EnrollmentTeacher", fields: [assignedTeacherId], references: [id], onDelete: Restrict)
  approvedBy      User?                      @relation("EnrollmentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  payments        Payment[]
  qr              EnrollmentQr?
  statusHistory   EnrollmentStatusHistory[]
  moduleProgress  EnrollmentModuleProgress[]
  admission       Admission?

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([assignedTeacherId])
  @@index([status])
}

model EnrollmentQr {
  id           String    @id @default(cuid())
  enrollmentId String    @unique
  token        String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model EnrollmentStatusHistory {
  id           String            @id @default(cuid())
  enrollmentId String
  fromStatus   EnrollmentStatus?
  toStatus     EnrollmentStatus
  changedById  String?
  createdAt    DateTime          @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  changedBy  User?      @relation("EnrollmentHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
}
