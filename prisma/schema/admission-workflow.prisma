model StudentRegistrationQr {
  id        String    @id @default(cuid())
  token     String    @unique
  bdmUserId String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  revokedAt DateTime?

  bdm       User       @relation("RegistrationQrBdm", fields: [bdmUserId], references: [id], onDelete: Restrict)
  admission Admission?

  @@index([bdmUserId])
}

model Admission {
  id                   String          @id @default(cuid())
  reference            String          @unique
  studentId            String
  registrationQrId     String          @unique
  bdmUserId            String
  status               AdmissionStatus @default(REGISTERED)
  courseId             String?
  admissionAmount      Decimal?        @db.Decimal(12, 2)
  paidAmount           Decimal?        @db.Decimal(12, 2)
  currency             String          @default("BDT")
  classStartingDate    DateTime?       @db.Date
  assignedTeacherId    String?
  submittedAt          DateTime?
  accountsApprovedById String?
  accountsApprovedAt   DateTime?
  enrollmentId         String?         @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  student            Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  registrationQr     StudentRegistrationQr    @relation(fields: [registrationQrId], references: [id], onDelete: Restrict)
  bdm                User                     @relation("AdmissionBdm", fields: [bdmUserId], references: [id], onDelete: Restrict)
  course             Course?                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignedTeacher    User?                    @relation("AdmissionTeacher", fields: [assignedTeacherId], references: [id], onDelete: Restrict)
  accountsApprovedBy User?                    @relation("AdmissionAccountsApprover", fields: [accountsApprovedById], references: [id], onDelete: Restrict)
  enrollment         Enrollment?              @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  statusHistory      AdmissionStatusHistory[]

  @@index([studentId])
  @@index([bdmUserId])
  @@index([status])
  @@index([courseId])
  @@index([assignedTeacherId])
}

model AdmissionStatusHistory {
  id          String           @id @default(cuid())
  admissionId String
  fromStatus  AdmissionStatus?
  toStatus    AdmissionStatus
  changedById String?
  createdAt   DateTime         @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("AdmissionHistoryActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([admissionId])
}
