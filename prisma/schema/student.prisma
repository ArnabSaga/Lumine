model RegistrationLink {
  id        String    @id @default(cuid())
  token     String    @unique
  bdmId     String
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bdm User @relation("RegistrationLinkBDM", fields: [bdmId], references: [id], onDelete: Restrict)

  @@index([bdmId])
  @@index([isActive])
}

model Student {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String
  address            String
  education          String
  additionalInfo     String?
  registeredViaBdmId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  registeredViaBdm User       @relation("StudentRegistrationBDM", fields: [registeredViaBdmId], references: [id], onDelete: Restrict)
  admission        Admission?

  @@index([registeredViaBdmId])
  @@index([email])
}
